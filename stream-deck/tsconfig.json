{
	"compilerOptions": {
		"target": "ES2022",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"useDefineForClassFields": false,
		"customConditions": [
			"node"
		],
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"noImplicitOverride": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
